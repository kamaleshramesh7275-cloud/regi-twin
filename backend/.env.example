# PhysioTwin Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Groq LLM API Key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Strava API v3 OAuth 2.0 (Developer App registered at https://www.strava.com/settings/api)
# Callback Domain should be set to: localhost
STRAVA_CLIENT_ID=your_strava_numeric_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret_hex
STRAVA_REDIRECT_URI=http://localhost:8000/oauth/strava/callback

# Strava OAuth Token Encryption Secret — encrypts refresh tokens at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_TOKEN_ENCRYPTION_SECRET=your_fernet_symmetric_encryption_key_here

# Google Health API (Fitbit) OAuth 2.0 (100% Free Google Cloud project, Testing mode up to 100 users)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_HEALTH_CLIENT_ID=your_google_health_oauth_client_id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your_google_health_oauth_client_secret
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8000/oauth/google-health/callback

# Google Health OAuth Token Encryption Secret — encrypts refresh tokens at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GHA_TOKEN_ENCRYPTION_SECRET=your_fernet_symmetric_encryption_key_here

# Hevy Pro Encryption Secret — symmetric key used to encrypt user personal Hevy API keys at rest
HEVY_KEY_ENCRYPTION_SECRET=your_fernet_symmetric_encryption_key_here

# Nutritionix Developer API (Backend-level keys for natural-language nutrition logging)
# Get free keys at: https://developer.nutritionix.com
NUTRITIONIX_APP_ID=your_nutritionix_app_id
NUTRITIONIX_API_KEY=your_nutritionix_api_key
